# Copy this file to .env and fill in your values. Never commit .env.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional compatible endpoint. Default is OpenAI. Use https, or http only on localhost.
# OPENAI_BASE_URL=https://api.openai.com/v1

EMAIL_ADDRESS=you@gmail.com
# Gmail: create an App Password at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
EMAIL_PASSWORD=your-16-char-app-password

# Gmail
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Outlook / Office 365 (use instead of the Gmail values above)
# IMAP_HOST=outlook.office365.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
